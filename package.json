{
  "name": "harnix",
  "version": "0.18.0",
  "description": "Open-source harness readiness scanner",
  "type": "module",
  "bin": {
    "harnix": "bin/harnix.js"
  },
  "files": [
    "bin",
    "checks/**/meta.yaml",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "prepack": "npm run build",
    "scan": "node bin/harnix.js scan .",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anakotai/harnix.git"
  },
  "bugs": {
    "url": "https://github.com/anakotai/harnix/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.11"
  }
}
